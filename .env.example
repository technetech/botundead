# Solo la API key de Undeadwallet. Nunca la clave privada de la wallet.
UNDEAD_API_KEY=
# dry-run = consultas y registros, sin abrir ni cerrar posiciones.
# live = ejecuta la estrategia con el saldo VIRTUAL de Undeadwallet.
BOT_MODE=dry-run
# En Railway montar un volumen persistente en /data y usar DATA_DIR=/data.
DATA_DIR=./data
