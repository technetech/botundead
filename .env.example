# Panel: usuario admin, contrasena nueva de al menos 12 caracteres.
DASHBOARD_PASSWORD=
# Sin DATABASE_URL: almacenamiento local persistente en DATA_DIR, creado al iniciar.
DATA_DIR=./data
# PostgreSQL: Railway/Vercel o local. Las tablas se crean al iniciar.
# Usar conexion directa o pool en modo session, NO transaction pooling.
DATABASE_URL=
# Cifrado de claves guardadas desde el panel. Obligatorio con PostgreSQL.
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Conservar esta clave y respaldarla; cambiarla impide leer las APIs guardadas.
CREDENTIALS_KEY=
# Agente 1: admite el nombre anterior o AGENT_1_UNDEAD_API_KEY.
UNDEAD_API_KEY=
# Agentes 1..10: configurar por variable o desde Conexiones API.
# AGENT_2_UNDEAD_API_KEY=
# Modo Agente: proveedor NVIDIA. La key nunca se necesita en modo Bot.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Alternativa compatible: LLM_API_KEY, LLM_MODEL y LLM_BASE_URL.
# Solo para importar un state.json anterior; los agentes nuevos empiezan en prueba.
BOT_MODE=dry-run
# Vercel: protege /api/cron. Usar un secreto aleatorio independiente.
CRON_SECRET=
# Docker Compose: contrasena de PostgreSQL (usar caracteres alfanumericos).
POSTGRES_PASSWORD=
# Comandos check / resume: espacio del agente, 1 por defecto.
AGENT_SLOT=1
# PORT=3000
